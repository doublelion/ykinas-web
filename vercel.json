{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "ykinas.com"
        }
      ],
      "destination": "https://www.ykinas.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/templates/tpl-01/:path*",
      "destination": "/templates/tpl-01/:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/reset-demo",
      "schedule": "0 15 * * *"
    }
  ]
}