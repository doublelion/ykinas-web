{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "ykinas.com"
        }
      ],
      "destination": "https://www.ykinas.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/templates/tpl-01/:path*",
      "destination": "/templates/tpl-01/:path*"
    },
    {
      "source": "/((?!templates/tpl-01|sitemap\\.xml|robots\\.txt|.*\\.).*)",
      "destination": "/index.html"
    }
  ]
}